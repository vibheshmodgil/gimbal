{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "device_capabilities.schema.json",
  "title": "GET /v1/info data: what a device is and what it can actually do",
  "type": "object",
  "required": [
    "schema_version",
    "device_id",
    "device_type",
    "software_version",
    "capabilities",
    "operations",
    "sensors"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "device_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "device_type": {
      "enum": [
        "assistant",
        "gimbal",
        "mobile_base",
        "camera",
        "sensor_hub"
      ]
    },
    "name": {
      "type": "string"
    },
    "software_version": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "description": "Advertise ONLY what is implemented and working. Names from docs/integration_contract.md#capabilities.",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+\\.[a-z_]+$"
      }
    },
    "operations": {
      "type": "array",
      "description": "Commands accepted by POST /v1/commands. args is a JSON Schema the device enforces.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "capability",
          "args",
          "long_running"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z_]+$"
          },
          "capability": {
            "type": "string"
          },
          "args": {
            "type": "object"
          },
          "long_running": {
            "type": "boolean"
          },
          "max_duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "moves_hardware": {
            "type": "boolean"
          }
        }
      }
    },
    "sensors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sensor_id",
          "sensor_type",
          "frame_id"
        ],
        "properties": {
          "sensor_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "sensor_type": {
            "enum": [
              "camera",
              "lidar",
              "imu",
              "odometry",
              "wheel_encoders",
              "presence",
              "microphone",
              "tof"
            ]
          },
          "frame_id": {
            "$ref": "common.schema.json#/$defs/frame_id"
          },
          "nominal_rate_hz": {
            "type": "number",
            "description": "Measured, not datasheet. Omit if unknown."
          }
        }
      }
    },
    "event_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "event_retention_s": {
      "type": "number",
      "minimum": 0
    },
    "unsupported": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Things a client might expect but this device does NOT do (e.g. closed_loop_position_feedback)."
    }
  }
}
