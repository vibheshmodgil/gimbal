{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anvyxo-device-proposal/0.1",
  "title": "Device subsystem contract PROPOSAL v0 (gimbal now, RC car later). Replace with the orchestrator's canonical contract when it exists.",
  "$defs": {
    "time": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d+)?Z$"},
    "id": {"type": "string", "minLength": 3},
    "error": {
      "type": "object", "required": ["error"],
      "properties": {"error": {"type": "object", "required": ["code", "message", "details", "request_id"],
        "properties": {"code": {"type": "string", "pattern": "^[A-Z_]+$"}, "message": {"type": "string"},
                       "details": {"type": "object"}, "request_id": {"type": ["string", "null"]}}}}
    },
    "health": {
      "type": "object", "required": ["schema", "device_id", "time", "alive", "ready", "not_ready_reasons"],
      "properties": {"schema": {"const": "health/v0"}, "device_id": {"$ref": "#/$defs/id"}, "time": {"$ref": "#/$defs/time"},
                     "alive": {"type": "boolean"}, "ready": {"type": "boolean"}, "not_ready_reasons": {"type": "array", "items": {"type": "string"}}}
    },
    "pose_pan_tilt": {
      "description": "Angles relative to THIS gimbal's calibrated zero. Not a global pose.",
      "type": ["object", "null"], "required": ["frame_id", "representation", "pan_deg", "tilt_deg", "source", "physically_verified"],
      "properties": {"frame_id": {"type": "string"}, "representation": {"const": "pan_tilt_relative"},
                     "pan_deg": {"type": "number"}, "tilt_deg": {"type": "number"},
                     "source": {"enum": ["firmware_commanded_open_loop", "encoder", "imu"]},
                     "physically_verified": {"type": "boolean"}, "global_pose": {"type": "null"}}
    },
    "operation": {
      "type": "object",
      "required": ["schema", "operation_id", "request_id", "kind", "state", "params", "created_at", "started_at", "device_ack_at", "ended_at", "progress", "result", "error"],
      "properties": {"schema": {"const": "operation/v0"}, "operation_id": {"$ref": "#/$defs/id"}, "request_id": {"$ref": "#/$defs/id"},
                     "kind": {"enum": ["move", "home", "survey"]},
                     "state": {"enum": ["accepted", "running", "succeeded", "failed", "cancelled", "preempted"]},
                     "params": {"type": "object"}, "progress": {"type": "object"},
                     "created_at": {"$ref": "#/$defs/time"},
                     "started_at": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
                     "device_ack_at": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
                     "ended_at": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
                     "result": {"type": ["object", "null"]},
                     "error": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["code", "message"]}]}}
    },
    "observation": {
      "type": "object",
      "required": ["schema", "observation_id", "created_at", "timestamp", "device_id", "sensor_id", "sensor_type", "data", "pose", "timing", "validity", "confidence", "processing", "source"],
      "properties": {"schema": {"const": "observation/v0"}, "observation_id": {"$ref": "#/$defs/id"},
                     "created_at": {"$ref": "#/$defs/time"}, "timestamp": {"$ref": "#/$defs/time"}, "received_at": {"$ref": "#/$defs/time"},
                     "device_id": {"$ref": "#/$defs/id"}, "sensor_id": {"$ref": "#/$defs/id"},
                     "sensor_type": {"enum": ["camera.rgb", "lidar.2d", "lidar.3d", "imu", "odometry"]},
                     "data": {"type": "object", "required": ["media_type", "ref"], "properties": {"media_type": {"type": "string"}, "ref": {"type": "string"}}},
                     "camera": {"type": "object", "properties": {"calibration_ref": {"type": ["string", "null"]}}},
                     "pose": {"$ref": "#/$defs/pose_pan_tilt"},
                     "timing": {"type": "object", "required": ["timestamp_source"]},
                     "validity": {"type": "object", "required": ["valid", "stale", "reasons"]},
                     "confidence": {"type": ["number", "null"]},
                     "processing": {"type": "object", "required": ["status", "model", "model_version", "results"]},
                     "source": {"type": "object"}}
    },
    "event": {
      "type": "object", "required": ["schema", "event_id", "seq", "type", "time", "device_id", "severity", "data"],
      "properties": {"schema": {"const": "event/v0"}, "event_id": {"$ref": "#/$defs/id"}, "seq": {"type": "integer", "minimum": 1},
                     "type": {"enum": ["device.connected", "device.fault", "device.state", "device.calibration_changed", "camera.available", "camera.unavailable",
                                       "operation.accepted", "operation.started", "operation.progress", "operation.succeeded", "operation.failed",
                                       "operation.cancelled", "operation.preempted", "motion.stopped", "survey.started", "survey.completed",
                                       "observation.created", "perception.person_visible", "perception.person_not_visible", "perception.presence_unknown"]},
                     "time": {"$ref": "#/$defs/time"}, "device_id": {"$ref": "#/$defs/id"}, "severity": {"enum": ["info", "warning", "error"]},
                     "data": {"type": "object"}}
    },
    "device_status": {
      "type": "object",
      "required": ["schema", "device_id", "device_type", "time", "connection", "ready", "not_ready_reasons", "calibration", "pose", "limits", "motion", "camera", "faults"],
      "properties": {"schema": {"const": "device_status/v0"}, "pose": {"$ref": "#/$defs/pose_pan_tilt"},
                     "faults": {"type": "array", "items": {"type": "object", "required": ["code", "severity", "message"]}},
                     "camera": {"$ref": "#/$defs/camera_status"}}
    },
    "camera_status": {
      "type": "object", "required": ["sensor_id", "sensor_type", "ready", "stream", "last_frame_at", "frame_age_ms", "stale", "width", "height", "config", "timing"],
      "properties": {"ready": {"type": "boolean"}, "stale": {"type": "boolean"}}
    },
    "device_descriptor": {
      "type": "object", "required": ["schema", "contract", "device_id", "device_type", "api_version", "axes", "sensors", "capabilities", "unsupported"],
      "properties": {"schema": {"const": "device_descriptor/v0"}, "capabilities": {"type": "array", "items": {"type": "string"}}}
    }
  }
}
